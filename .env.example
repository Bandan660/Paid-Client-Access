# ============================================================
# Environment Variables Configuration
# Senior Full-Stack Integration Engineer: Paid Client Access
# Architecture: React (Vite) + Node.js (Express) + Supabase
# ============================================================

# ------------------------------------------------------------
# 1. Server & Client Connectivity
# ------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------
# 2. Supabase Configuration (Test Environment)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------
# Publicly accessible credentials (used by React client with Row-Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-only Admin Key (Bypasses RLS for webhooks & background sync - NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------
# 3. Stripe Sandbox Configuration (Test Mode)
# Obtain from: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------
# Secret Key (Server-side only)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (Server-side only)
# Obtain via Stripe CLI: `stripe listen --forward-to localhost:5000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Public Key (optional for checkout redirects)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# ------------------------------------------------------------
# 4. Zoho CRM Configuration (Developer Edition / Sandbox)
# Setup via Zoho Developer Console: https://api-console.zoho.com
# ------------------------------------------------------------
# Accounts Domain (depends on regional data center: .com, .eu, .in, .com.au)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# API Domain
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Zoho Client ID & Secret (from Zoho API Console -> Self Client or Server-based)
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zoho OAuth Refresh Token (generated with scope: ZohoCRM.modules.ALL or ZohoCRM.modules.deals.UPDATE)
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Deal Stage to apply upon confirmed payment (defaults to 'Closed Won')
ZOHO_DEAL_STAGE_PAID="Closed Won"

# Default Deal ID to update if not specified in checkout
DEFAULT_ZOHO_DEAL_ID=DEMO_DEAL_1001

# ------------------------------------------------------------
# 5. Outage Simulation / Walkthrough Flags
# ------------------------------------------------------------
# Set to 'true' to simulate Zoho CRM 503 outage during the live walkthrough
# to demonstrate that client access remains granted while the sync record is marked 'pending'
SIMULATE_ZOHO_FAILURE=false
